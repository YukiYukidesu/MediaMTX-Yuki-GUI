<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MediaMTX_Yuki_GUI</RootNamespace>
    <AssemblyName>MediaMTX-Yuki-GUI</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.0.2</Version>

    <!--
      GUI 已验证过的 MediaMTX 引擎版本（带引擎那个包预装的就是这一版）。
      这里只写数字、不带 v：build-release.ps1 拿它直接拼资产名
      mediamtx_v<版本>_windows_amd64.zip；程序里由 ProgramVersion.RecommendedEngineVersion
      读出来补上 v 前缀再给界面用。要升就改这一处，别在 C# 与脚本里各写一份。
    -->
    <RecommendedEngineVersion>1.21.3</RecommendedEngineVersion>

    <Product>MediaMTX-Yuki-GUI</Product>
    <Description>轻量 RTMP 多路转发控制器</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!--
      AVLN3001：两个编辑窗（InputEditorWindow / TargetEditorWindow）只有带参数的构造函数，
      因为它们必须拿到被编辑的那一条数据才能建出来，永远由代码 new 出来、不走 XAML 运行时加载器。
      这个警告说的正是「XAML 资源无法通过运行时加载器访问，因为没有 public 无参构造」——
      对这两个窗口是预期行为，不是缺陷。为了保持 0 警告的构建基线，在这里显式静音。
      以后若真要做成可被 XAML 加载的窗口，必须删掉这一行，让警告重新出现提醒你补无参构造。
    -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>

    <!--
      发布形态：自包含 + 裁剪 + 单文件（见 build-release.ps1）。
      运行时不外挂 runtime.dotnet\、也不依赖系统装的 .NET——它被裁过之后直接焊在 exe 里，
      所以出厂产物就是「一个 exe 加一个 Languages\」。以前那套
      AppHostRelativeDotNet / AppHostDotNetSearch 是给「外挂运行时 + 回落到系统 .NET」用的，
      改走自包含之后必须删掉：留着它 apphost 仍会优先去 exe 旁边找 runtime.dotnet\。
    -->

    <!--
      裁剪（PublishTrimmed）会把 System.Text.Json 的反射序列化开关关掉，
      配置读写（AppConfig / UpdateOptions 这些 POCO）当场抛
      「Reflection-based serialization has been disabled」。这个属性会写进 runtimeconfig 的
      configProperties，把开关显式打开——不写它，裁剪版起不来。
    -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>


  <ItemGroup>
    <!-- 把推荐引擎版本塞进程序集元数据：运行时读得到，与上面那个属性同源 -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RecommendedEngineVersion</_Parameter1>
      <_Parameter2>$(RecommendedEngineVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\app-icon.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Languages\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    发布产物里不要任何 pdb。
    SkiaSharp / HarfBuzzSharp 的 NuGet 包会带 native 的 pdb（libSkiaSharp.pdb 一个就 82 MB），
    DebugType 之类的属性管不到它们，只能在 publish 之后删。
    本地 Debug / Release 构建不受影响，obj 与 bin 里的 pdb 照常在。
  -->
  <Target Name="StripPublishSymbols" AfterTargets="Publish">
    <ItemGroup>
      <LeftoverPdb Include="$(PublishDir)*.pdb" />
      <LeftoverPdb Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(LeftoverPdb)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
