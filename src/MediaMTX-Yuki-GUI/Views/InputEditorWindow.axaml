<ui:FAAppWindow x:Class="MediaMTX_Yuki_GUI.Views.InputEditorWindow"
                xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:FluentAvalonia.UI.Windowing"
                xmlns:loc="using:MediaMTX_Yuki_GUI"
                Title="{Binding WindowTitle}"
                Width="520"
                MinHeight="440"
                MaxHeight="1000"
                SizeToContent="Height"
                CanResize="False"
                CanMaximize="False"
                WindowStartupLocation="CenterOwner"
                TextOptions.TextRenderingMode="Antialias">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">

    <TextBlock Grid.Row="0"
               Margin="0,0,0,20"
               Classes="page-subtitle"
               Text="{loc:Loc l003-006}" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <TextBlock Classes="field-label" Text="{loc:Loc c003-002}" />
        <TextBox Margin="0,4,0,4" Text="{Binding SourceName, Mode=TwoWay}" />

        <!-- 重名只提醒不拦：两条备注一样也能存，只是提醒别搞混 -->
        <TextBlock Margin="0,0,0,12"
                   Classes="warning-hint"
                   IsVisible="{Binding HasNameWarning}"
                   Text="{Binding NameWarning}" />

        <!-- 来源方式：接收推流 / 主动拉流。两者互斥，MediaMTX 的 source 一次只能填一个值。
             摆成两张并排的小卡片而不是下拉：拢共就两种，摊开一眼能看清，少点一次多一层菜单。
             简洁模式下只给「接收推流」一张，第二张整块收起来。 -->
        <TextBlock Classes="field-label" Text="{loc:Loc c003-032}" />
        <Grid Margin="0,4,0,4" ColumnDefinitions="*,10,*">
          <Border Grid.Column="0"
                  Grid.ColumnSpan="{Binding PushCardSpan}"
                  Classes="kind-card"
                  Classes.on="{Binding IsPushKind}"
                  PointerPressed="OnPushKindPressed">
            <StackPanel>
              <TextBlock Classes="kind-title" Text="{loc:Loc c003-019}" />
              <TextBlock Classes="kind-note" Text="{loc:Loc l003-009}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                  Classes="kind-card"
                  Classes.on="{Binding IsPullKind}"
                  IsVisible="{Binding ShowPullCard}"
                  PointerPressed="OnPullKindPressed">
            <StackPanel>
              <TextBlock Classes="kind-title" Text="{loc:Loc c003-018}" />
              <TextBlock Classes="kind-note" Text="{loc:Loc l003-010}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- 协议与端口只对「接收推流」有意义：拉流模式下这条路径不再监听，藏起来免得误导 -->
        <Grid Margin="0,0,0,16" ColumnDefinitions="*,16,140"
              IsVisible="{Binding !IsPulling}">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="field-label" Text="{loc:Loc c003-033}" />
            <ComboBox Margin="0,4,0,0"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding ProtocolChoices}"
                      SelectedItem="{Binding SelectedProtocolChoice, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Classes="field-label" Text="{loc:Loc c003-034}" />
            <TextBox Margin="0,4,0,0"
                     TextAlignment="Right"
                     PlaceholderText="{Binding PortPlaceholder}"
                     Text="{Binding Port, Mode=TwoWay}" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="field-label" Text="{loc:Loc c003-036}" />
          <TextBlock Text="*" Classes="required-mark" />
        </StackPanel>
        <TextBox Margin="0,4,0,4"
                 Classes.invalid="{Binding PathInvalid}"
                 LostFocus="OnPathNameLostFocus"
                 Text="{Binding PathName, Mode=TwoWay}" />
        <TextBlock Margin="0,0,0,4"
                   Classes="danger-hint"
                   IsVisible="{Binding PathInvalid}"
                   Text="{Binding PathErrorText}" />
        <TextBlock Classes="hint" Text="{loc:Loc l003-007}" />

        <!-- 主动拉流时才显示；留空则是接收推流 -->
        <StackPanel Margin="0,16,0,0" IsVisible="{Binding IsPulling}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="field-label" Text="{loc:Loc c003-037}" />
            <TextBlock Text="*" Classes="required-mark" />
          </StackPanel>
          <TextBox Margin="0,4,0,4"
                   Classes.invalid="{Binding PullUrlInvalid}"
                   LostFocus="OnPullUrlLostFocus"
                   PlaceholderText="rtmp://host/app/stream"
                   Text="{Binding PullUrl, Mode=TwoWay}" />
          <TextBlock Margin="0,0,0,4"
                     Classes="danger-hint"
                     IsVisible="{Binding PullUrlInvalid}"
                     Text="{loc:Loc l003-001}" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{loc:Loc l003-008}" />
        </StackPanel>

        <TextBlock Margin="0,4,0,0"
                   Classes="danger-hint"
                   IsVisible="{Binding HasPortWarning}"
                   Text="{Binding PortWarning}" />

        <!-- 允许推流的账号：一颗标签都没加 = 不限制，任何账号都能推这条 path。
             账号多的时候点「+」从弹层里挑，已选的显示成带叉的标签，点叉就摘掉；
             高级模式下即使还没建账号也留出这块，好让人知道这里能配 -->
        <StackPanel Margin="0,18,0,0" IsVisible="{Binding ShowAccountPicker}">

          <TextBlock Classes="field-label" Text="{loc:Loc c003-043}" />

          <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding SelectedAccounts}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="account-chip" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding User}" />
                    <Button Margin="2,0,0,0"
                            Classes="chip-close"
                            Click="OnRemoveAccountClick"
                            Content="&#x00D7;"
                            ToolTip.Tip="{loc:Loc c003-055}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button x:Name="AddAccountButton"
                  Margin="0,2,0,0"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding HasAccounts}">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="+" />
              <TextBlock VerticalAlignment="Center" Text="{loc:Loc c003-054}" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft"
                      ShowMode="Transient"
                      FlyoutPresenterClasses="bare">
                <Border Padding="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        BoxShadow="0 8 24 0 #33000000"
                        CornerRadius="{StaticResource DsRadiusMd}">
                  <ScrollViewer MaxHeight="240"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Margin="4,2,4,4"
                                 Classes="hint"
                                 IsVisible="{Binding !HasSelectableAccounts}"
                                 Text="{loc:Loc l003-017}" />
                      <ItemsControl ItemsSource="{Binding SelectableAccounts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Classes="account-option"
                                    Click="OnPickAccountClick"
                                    Content="{Binding User}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>

          <TextBlock Margin="0,4,0,0"
                     Classes="hint"
                     TextWrapping="Wrap"
                     IsVisible="{Binding IsAccountListEmpty}"
                     Text="{loc:Loc l003-016}" />

          <TextBlock Margin="0,2,0,0"
                     Classes="hint"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasAccounts}"
                     Text="{loc:Loc l003-014}" />
        </StackPanel>

        <!-- 两个开关并排在最后一行：先启用，才谈得上录制，所以录制的开关跟着前一个走 -->
        <StackPanel Margin="0,20,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
          <TextBlock VerticalAlignment="Center" Text="{loc:Loc c003-039}" />
          <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}" />
          <StackPanel Margin="24,0,0,0"
                      Orientation="Horizontal"
                      Spacing="10"
                      IsVisible="{Binding IsAdvancedMode}">
            <TextBlock VerticalAlignment="Center" Text="{loc:Loc c003-042}" />
            <ToggleSwitch VerticalAlignment="Center"
                          IsChecked="{Binding RecordShown, Mode=TwoWay}"
                          IsEnabled="{Binding Enabled}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- 缺什么直接标在对应的框下面了，这里只管放按钮 -->
    <StackPanel Grid.Row="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button MinWidth="88"
              Content="{loc:Loc c001-020}"
              Command="{Binding CancelCommand}"
              IsCancel="True" />
      <Button Margin="8,0,0,0" MinWidth="88" Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" />
    </StackPanel>
  </Grid>
</ui:FAAppWindow>
