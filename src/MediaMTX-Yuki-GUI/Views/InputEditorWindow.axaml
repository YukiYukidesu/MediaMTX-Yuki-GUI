<ui:FAAppWindow x:Class="MediaMTX_Yuki_GUI.Views.InputEditorWindow"
                xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:FluentAvalonia.UI.Windowing"
                xmlns:loc="using:MediaMTX_Yuki_GUI"
                Title="{Binding WindowTitle}"
                Width="520"
                MinHeight="440"
                MaxHeight="1000"
                SizeToContent="Height"
                CanResize="False"
                CanMaximize="False"
                WindowStartupLocation="CenterOwner"
                TextOptions.TextRenderingMode="Antialias">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">

    <TextBlock Grid.Row="0"
               Margin="0,0,0,20"
               Classes="page-subtitle"
               Text="{loc:Loc l003-003}" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <TextBlock Classes="field-label" Text="{loc:Loc c003-002}" />
        <TextBox Margin="0,4,0,4" Text="{Binding SourceName, Mode=TwoWay}" />

        <!-- 重名只提醒不拦：两条备注一样也能存，只是提醒别搞混 -->
        <TextBlock Margin="0,0,0,12"
                   Classes="warning-hint"
                   IsVisible="{Binding HasNameWarning}"
                   Text="{Binding NameWarning}" />

        <!-- 来源方式：接收推流 / 主动拉流。两者互斥，MediaMTX 的 source 一次只能填一个值。
             摆成两张并排的小卡片而不是下拉：拢共就两种，摊开一眼能看清，少点一次多一层菜单。
             简洁模式下只给「接收推流」一张，第二张整块收起来。 -->
        <TextBlock Classes="field-label" Text="{loc:Loc c003-013}" />
        <Grid Margin="0,4,0,4" ColumnDefinitions="*,10,*">
          <Border Grid.Column="0"
                  Grid.ColumnSpan="{Binding PushCardSpan}"
                  Classes="kind-card"
                  Classes.on="{Binding IsPushKind}"
                  PointerPressed="OnPushKindPressed">
            <StackPanel>
              <TextBlock Classes="kind-title" Text="{loc:Loc l003-014}" />
              <TextBlock Classes="kind-note" Text="{loc:Loc l003-007}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                  Classes="kind-card"
                  Classes.on="{Binding IsPullKind}"
                  IsVisible="{Binding ShowPullCard}"
                  PointerPressed="OnPullKindPressed">
            <StackPanel>
              <TextBlock Classes="kind-title" Text="{loc:Loc l003-012}" />
              <TextBlock Classes="kind-note" Text="{loc:Loc l003-008}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- 协议与端口只对「接收推流」有意义：拉流模式下这条路径不再监听，藏起来免得误导 -->
        <Grid Margin="0,0,0,16" ColumnDefinitions="*,16,140"
              IsVisible="{Binding !IsPulling}">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="field-label" Text="{loc:Loc c003-014}" />
            <ComboBox Margin="0,4,0,0"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding ProtocolChoices}"
                      SelectedItem="{Binding SelectedProtocolChoice, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Classes="field-label" Text="{loc:Loc c003-015}" />
            <TextBox Margin="0,4,0,0"
                     TextAlignment="Right"
                     PlaceholderText="{Binding PortPlaceholder}"
                     Text="{Binding Port, Mode=TwoWay}" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="field-label" Text="{loc:Loc c003-016}" />
          <TextBlock Text="*" Classes="required-mark" />
        </StackPanel>
        <TextBox Margin="0,4,0,4"
                 Classes.invalid="{Binding PathInvalid}"
                 LostFocus="OnPathNameLostFocus"
                 Text="{Binding PathName, Mode=TwoWay}" />
        <TextBlock Margin="0,0,0,4"
                   Classes="danger-hint"
                   IsVisible="{Binding PathInvalid}"
                   Text="{Binding PathErrorText}" />
        <TextBlock Classes="hint" Text="{loc:Loc l003-004}" />

        <!-- 主动拉流时才显示；留空则是接收推流 -->
        <StackPanel Margin="0,16,0,0" IsVisible="{Binding IsPulling}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="field-label" Text="{loc:Loc c003-017}" />
            <TextBlock Text="*" Classes="required-mark" />
          </StackPanel>
          <TextBox Margin="0,4,0,4"
                   Classes.invalid="{Binding PullUrlInvalid}"
                   LostFocus="OnPullUrlLostFocus"
                   PlaceholderText="rtmp://host/app/stream"
                   Text="{Binding PullUrl, Mode=TwoWay}" />
          <TextBlock Margin="0,0,0,4"
                     Classes="danger-hint"
                     IsVisible="{Binding PullUrlInvalid}"
                     Text="{loc:Loc l003-001}" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{loc:Loc l003-005}" />
        </StackPanel>

        <TextBlock Margin="0,4,0,0"
                   Classes="danger-hint"
                   IsVisible="{Binding HasPortWarning}"
                   Text="{Binding PortWarning}" />

        <!-- 允许推流的账号：一颗标签都没加 = 不限制，任何账号都能推这条 path。
             账号多的时候点「+」从弹层里挑，已选的显示成带叉的标签，点叉就摘掉；
             高级模式下即使还没建账号也留出这块，好让人知道这里能配 -->
        <StackPanel Margin="0,18,0,0" IsVisible="{Binding ShowAccountPicker}">

          <!-- 标题行右边放「+ 添加账号」：标签再多也不会把它挤到下一行去 -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center"
                       Classes="field-label"
                       Text="{loc:Loc c003-018}" />

            <Button x:Name="AddAccountButton"
                    Grid.Column="1"
                    IsVisible="{Binding HasAccounts}">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="+" />
                <TextBlock VerticalAlignment="Center" Text="{loc:Loc l003-017}" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight"
                        ShowMode="Transient"
                        FlyoutPresenterClasses="bare">
                  <Border Padding="6"
                          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          BoxShadow="0 8 24 0 #33000000"
                          CornerRadius="{StaticResource DsRadiusMd}">
                    <ScrollViewer MaxHeight="240"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <TextBlock Margin="4,2,4,4"
                                   Classes="hint"
                                   IsVisible="{Binding !HasSelectableAccounts}"
                                   Text="{loc:Loc l003-011}" />
                        <ItemsControl ItemsSource="{Binding SelectableAccounts}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Classes="account-option"
                                      Click="OnPickAccountClick"
                                      Content="{Binding User}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>

          <!-- 账号盒子：标签最多露三行，再多就在框里滚动，不把下面的开关挤走；
               一个账号都没有时它就是一块空框，免得让人以为这里根本配不了 -->
          <Border Margin="0,6,0,0"
                  MinHeight="48"
                  Padding="10,8,10,3"
                  Background="{DynamicResource DsWellBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource DsRadiusMd}">
            <Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            IsVisible="{Binding HasAccounts}">
                <!-- 换成列表页那种扁平滚动条：默认那条带两端箭头、还粗，
                     而且它贴着 ScrollViewer 的底，框内留白一多就显得悬在半空 -->
                <ScrollViewer.Styles>
                  <Style Selector="ScrollBar:horizontal">
                    <Setter Property="Theme" Value="{StaticResource DsFlatScrollBar}" />
                  </Style>
                </ScrollViewer.Styles>
                <ItemsControl ItemsSource="{Binding SelectedAccounts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>

                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="account-chip" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock VerticalAlignment="Center" Text="{Binding User}" />
                          <Button Margin="2,0,0,0"
                                  Classes="chip-close"
                                  Click="OnRemoveAccountClick"
                                  Content="&#x00D7;"
                                  ToolTip.Tip="{loc:Loc l003-024}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Classes="hint"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         IsVisible="{Binding IsAccountListEmpty}"
                         Text="{loc:Loc l003-010}" />

              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Classes="hint"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         IsVisible="{Binding ShowPickHint}"
                         Text="{loc:Loc l003-013}" />
            </Grid>
          </Border>

          <TextBlock Margin="0,2,0,0"
                     Classes="hint"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasAccounts}"
                     Text="{loc:Loc l003-009}" />
        </StackPanel>

        <!-- 两个开关并排在最后一行：先启用，才谈得上录制，所以录制的开关跟着前一个走 -->
        <StackPanel Margin="0,20,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
          <TextBlock VerticalAlignment="Center" Text="{loc:Loc l003-015}" />
          <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}" />
          <StackPanel Margin="24,0,0,0"
                      Orientation="Horizontal"
                      Spacing="10"
                      IsVisible="{Binding IsAdvancedMode}">
            <TextBlock VerticalAlignment="Center" Text="{loc:Loc l003-016}" />
            <ToggleSwitch VerticalAlignment="Center"
                          IsChecked="{Binding RecordShown, Mode=TwoWay}"
                          IsEnabled="{Binding Enabled}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- 缺什么直接标在对应的框下面了，这里只管放按钮 -->
    <StackPanel Grid.Row="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button MinWidth="88"
              Content="{loc:Loc b001-006}"
              Command="{Binding CancelCommand}"
              IsCancel="True" />
      <Button Margin="8,0,0,0" MinWidth="88" Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" />
    </StackPanel>
  </Grid>
</ui:FAAppWindow>
