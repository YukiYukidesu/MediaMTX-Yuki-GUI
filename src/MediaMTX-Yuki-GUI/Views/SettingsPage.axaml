<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:MediaMTX_Yuki_GUI"
             xmlns:c="using:MediaMTX_Yuki_GUI.Controls"
             x:Class="MediaMTX_Yuki_GUI.Views.SettingsPage">
  <ScrollViewer x:Name="SettingsScroller"
                VerticalScrollBarVisibility="Auto">
  <!-- 栏与栏之间 8 而不是全站默认的 12：设置页是十几个等高卡片的竖排，
       间距按列表的密度给，不按普通卡片流给 -->
  <StackPanel Margin="{StaticResource DsPagePadding}" Spacing="8">

    <StackPanel Margin="{StaticResource DsCardGap}">
      <TextBlock Text="{loc:Loc c001-010}" Classes="page-title" />
      <TextBlock Text="{loc:Loc ls00-001}" Classes="page-subtitle" />
    </StackPanel>

    <TextBox PlaceholderText="{loc:Loc ls00-002}"
             Text="{Binding SettingsSearch, Mode=TwoWay}" />

    <TextBlock Text="{loc:Loc cs00-001}"
               Classes="hint"
               IsVisible="{Binding HasNoSettingsMatch}"
               Margin="4,0,0,0" />

    <!-- 界面外观 -->
    <c:SmoothExpander IsExpanded="{Binding IsAppearanceGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsAppearanceGroupShown}"
                      Title="{loc:Loc cs01-001}">

      <StackPanel>

        <c:SettingRow Glyph="&#xE790;"
                      Title="{loc:Loc cs01-002}"
                      Description="{loc:Loc ls01-003}">
          <ComboBox HorizontalAlignment="Right"
                    SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
            <ComboBoxItem Content="{loc:Loc bs01-001}" Tag="system" />
            <ComboBoxItem Content="{loc:Loc bs01-002}" Tag="light" />
            <ComboBoxItem Content="{loc:Loc bs01-003}" Tag="dark" />
          </ComboBox>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE790;"
                      Title="{loc:Loc cs01-003}"
                      Description="{loc:Loc ls01-001}">
          <ComboBox HorizontalAlignment="Right"
                    SelectedIndex="{Binding WindowBackdropIndex, Mode=TwoWay}">
            <ComboBoxItem Content="{loc:Loc bs01-004}" Tag="mica" />
            <ComboBoxItem Content="{loc:Loc bs01-005}" Tag="acrylic" />
            <ComboBoxItem Content="{loc:Loc bs01-006}" Tag="solid" />
          </ComboBox>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE8C1;"
                      Title="{loc:Loc cs01-004}">
          <ComboBox HorizontalAlignment="Right"
                    ItemsSource="{Binding LanguageChoices}"
                    SelectedItem="{Binding SelectedLanguageChoice, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE7F8;"
                      Title="{loc:Loc cs01-005}"
                      Description="{loc:Loc ls01-002}">
          <ToggleSwitch IsChecked="{Binding HardwareAcceleration, Mode=TwoWay}" />
        </c:SettingRow>

      </StackPanel>
    </c:SmoothExpander>

    <!-- 窗口与启动 -->
    <c:SmoothExpander IsExpanded="{Binding IsShellGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsShellGroupShown}"
                      Title="{loc:Loc cs02-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls02-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <c:SettingRow Glyph="&#xE7E8;"
                      Title="{loc:Loc cs02-002}"
                      Description="{loc:Loc ls02-003}">
          <ToggleSwitch IsChecked="{Binding StartWithWindows}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE921;"
                      Title="{loc:Loc cs02-003}"
                      Description="{loc:Loc ls02-004}">
          <ToggleSwitch IsChecked="{Binding CloseToTray}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE81C;"
                      Title="{loc:Loc cs02-004}"
                      Description="{loc:Loc ls02-002}">
          <ComboBox HorizontalAlignment="Right"
                    SelectedIndex="{Binding MemoryTrimIndex, Mode=TwoWay}">
            <ComboBoxItem Content="{loc:Loc bs02-001}" Tag="instant" />
            <ComboBoxItem Content="{loc:Loc bs02-002}" Tag="fast" />
            <ComboBoxItem Content="{loc:Loc bs02-003}" Tag="default" />
            <ComboBoxItem Content="{loc:Loc bs02-004}" Tag="off" />
          </ComboBox>
        </c:SettingRow>
      </StackPanel>
    </c:SmoothExpander>

    <!-- 引擎行为 -->
    <c:SmoothExpander IsExpanded="{Binding IsEngineGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsEngineGroupShown}"
                      Title="{loc:Loc cs03-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls03-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <c:SettingRow Glyph="&#xE768;"
                      Title="{loc:Loc cs03-002}"
                      Description="{loc:Loc ls03-005}">
          <ToggleSwitch IsChecked="{Binding AutoStartEngine}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE72C;"
                      Title="{loc:Loc cs03-003}"
                      Description="{loc:Loc ls03-006}">
          <ToggleSwitch IsChecked="{Binding AutoRestartEngine}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE81C;"
                      Title="{loc:Loc cs03-004}"
                      Description="{loc:Loc ls03-002}">
          <ComboBox HorizontalAlignment="Right"
                    SelectedIndex="{Binding LogRetentionIndex, Mode=TwoWay}">
            <ComboBoxItem Content="{loc:Loc bs03-001}" />
            <ComboBoxItem Content="{loc:Loc bs03-002}" />
            <ComboBoxItem Content="{loc:Loc bs03-003}" />
            <ComboBoxItem Content="{loc:Loc bs03-004}" />
          </ComboBox>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE8B7;"
                      Title="{loc:Loc cs03-005}"
                      Description="{loc:Loc ls03-003}">
          <ToggleSwitch IsChecked="{Binding PathAllOthers}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE916;"
                      Title="{loc:Loc cs03-006}"
                      Description="{loc:Loc ls03-004}">
          <ToggleSwitch IsChecked="{Binding UseAbsoluteTimestamp}" />
        </c:SettingRow>
      </StackPanel>
    </c:SmoothExpander>

    <!-- 网络与更新 -->
    <c:SmoothExpander x:Name="NetworkGroup"
                      IsExpanded="{Binding IsNetworkGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsNetworkGroupShown}"
                      Title="{loc:Loc cs04-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls04-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <c:SettingRow Glyph="&#xE896;"
                      Title="{loc:Loc cs04-002}"
                      Description="{loc:Loc ls04-011}"
                      Caution="{loc:Loc ls04-007}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding UpdateSourceNames}"
                      SelectedIndex="{Binding AppSourceIndex, Mode=TwoWay}" />
            <ToggleSwitch IsChecked="{Binding CheckAppUpdateOnStartup}" />
          </StackPanel>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE8F1;"
                      Title="{loc:Loc cs04-003}"
                      Description="{loc:Loc ls04-012}"
                      Caution="{loc:Loc ls04-008}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox HorizontalAlignment="Right"
                      ItemsSource="{Binding UpdateSourceNames}"
                      SelectedIndex="{Binding EngineSourceIndex, Mode=TwoWay}" />
            <ToggleSwitch IsChecked="{Binding CheckEngineUpdateOnStartup}" />
          </StackPanel>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE968;"
                      Title="{loc:Loc cs04-004}"
                      Description="{loc:Loc ls04-002}"
                      Required="{Binding StreamProxyRequired}"
                      Caution="{loc:Loc ls04-004}"
                      Warning="{Binding StreamProxyWarning}">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBox Width="256"
                     Text="{Binding StreamProxyUrl, Mode=TwoWay}"
                     IsEnabled="{Binding IsStreamProxyManual}"
                     Classes.invalid="{Binding StreamProxyUrlInvalid}"
                     PlaceholderText="socks5://127.0.0.1:8888" />
            <ComboBox HorizontalAlignment="Right"
                      SelectedIndex="{Binding StreamProxyIndex, Mode=TwoWay}">
              <ComboBoxItem Content="{loc:Loc bs04-001}" Tag="direct" />
              <ComboBoxItem Content="{loc:Loc bs04-002}" Tag="system" />
              <ComboBoxItem Content="{loc:Loc bs04-003}" Tag="manual" />
            </ComboBox>
          </StackPanel>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE968;"
                      Title="{loc:Loc cs04-005}"
                      Description="{loc:Loc ls04-003}"
                      Required="{Binding UpdateProxyRequired}"
                      Caution="{loc:Loc ls04-009}"
                      Warning="{Binding UpdateProxyWarning}">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBox Width="256"
                     Text="{Binding UpdateProxyUrl, Mode=TwoWay}"
                     IsEnabled="{Binding IsUpdateProxyManual}"
                     Classes.invalid="{Binding UpdateProxyUrlInvalid}"
                     PlaceholderText="socks5://127.0.0.1:8888" />
            <ComboBox HorizontalAlignment="Right"
                      SelectedIndex="{Binding UpdateProxyIndex, Mode=TwoWay}">
              <ComboBoxItem Content="{loc:Loc bs04-001}" Tag="direct" />
              <ComboBoxItem Content="{loc:Loc bs04-002}" Tag="system" />
              <ComboBoxItem Content="{loc:Loc bs04-003}" Tag="manual" />
            </ComboBox>
          </StackPanel>
        </c:SettingRow>

        <!-- 本程序更新：按下面的通道决定查正式版还是连预览版一起查，装完自己重启 -->
        <c:SettingRow Glyph="&#xE895;"
                      Title="{loc:Loc cs04-006}"
                      Description="{loc:Loc ls04-005}"
                      Caution="{loc:Loc ls04-010}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox MinWidth="112"
                      SelectedIndex="{Binding AppChannelIndex, Mode=TwoWay}">
              <ComboBoxItem Content="{loc:Loc bs04-006}" />
              <ComboBoxItem Content="{loc:Loc bs04-007}" />
            </ComboBox>
            <Button Content="{loc:Loc bs04-004}"
                    MinWidth="88"
                    Command="{Binding CheckAppUpdateCommand}" />
            <Button Classes="primary"
                    Content="{loc:Loc bs04-005}"
                    MinWidth="88"
                    Command="{Binding InstallAppUpdateCommand}"
                    IsVisible="{Binding HasAppUpdate}" />
          </StackPanel>
        </c:SettingRow>

        <TextBlock Text="{Binding AppUpdateStatus}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="28,0,0,8"
                   IsVisible="{Binding HasAppUpdateStatus}" />

        <!--
          引擎更新：只查正式版；装前先停引擎，装完按原状态恢复。
          通道切到「推荐适配版本」时不看远端，只跟 GUI 验证过的那一版比，不一致就往回换。
        -->
        <c:SettingRow Glyph="&#xE7F8;"
                      Title="{loc:Loc cs04-007}"
                      Description="{loc:Loc ls04-006}"
                      Caution="{Binding EngineUpdateCaution}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox MinWidth="132"
                      SelectedIndex="{Binding EngineChannelIndex, Mode=TwoWay}">
              <ComboBoxItem Content="{loc:Loc bs04-008}" />
              <ComboBoxItem Content="{loc:Loc bs04-009}" />
            </ComboBox>
            <Button Content="{loc:Loc bs04-004}"
                    MinWidth="88"
                    Command="{Binding CheckEngineUpdateCommand}" />
            <Button Classes="primary"
                    Content="{loc:Loc bs04-005}"
                    MinWidth="88"
                    Command="{Binding InstallEngineUpdateCommand}"
                    IsVisible="{Binding HasEngineUpdate}" />
          </StackPanel>
        </c:SettingRow>

        <TextBlock Text="{Binding EngineUpdateStatus}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="28,0,0,8"
                   IsVisible="{Binding HasEngineUpdateStatus}" />

      </StackPanel>
    </c:SmoothExpander>

    <!-- 容错与调参 -->
    <c:SmoothExpander IsExpanded="{Binding IsTuningGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsTuningGroupShown}"
                      Title="{loc:Loc cs05-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls05-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <c:SettingRow Glyph="&#xE8A5;"
                      Title="{loc:Loc cs05-002}"
                      Description="{loc:Loc ls05-002}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding MaxReaders}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE73E;"
                      Title="{loc:Loc cs05-003}"
                      Description="{loc:Loc ls05-003}">
          <ToggleSwitch IsChecked="{Binding AlwaysAvailable}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE8AB;"
                      Title="{loc:Loc cs05-004}"
                      Description="{loc:Loc ls05-004}">
          <ToggleSwitch IsChecked="{Binding OverridePublisher}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE916;"
                      Title="{loc:Loc cs05-005}"
                      Description="{loc:Loc ls05-005}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding ReadTimeoutSeconds}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE916;"
                      Title="{loc:Loc cs05-006}"
                      Description="{loc:Loc ls05-006}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding WriteTimeoutSeconds}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE8EF;"
                      Title="{loc:Loc cs05-007}"
                      Description="{loc:Loc ls05-007}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding WriteQueueSize}" />
        </c:SettingRow>

      </StackPanel>
    </c:SmoothExpander>

    <!-- 运维接口 -->
    <c:SmoothExpander IsExpanded="{Binding IsOpsGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsOpsGroupShown}"
                      Title="{loc:Loc cs06-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls06-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <c:SettingRow Glyph="&#xE968;"
                      Title="Control API"
                      Description="{loc:Loc ls06-002}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding ApiPort}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE9D9;"
                      Title="Metrics"
                      Description="{loc:Loc ls06-003}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding MetricsPort}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE7F4;"
                      Title="{loc:Loc cs06-002}"
                      Description="{loc:Loc ls06-004}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBox Width="88" TextAlignment="Right" VerticalAlignment="Center"
                     IsEnabled="{Binding PprofEnabled}"
                     Text="{Binding PprofPort}" />
            <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding PprofEnabled}" />
          </StackPanel>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE768;"
                      Title="{loc:Loc cs06-003}"
                      Description="{loc:Loc ls06-005}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBox Width="88" TextAlignment="Right" VerticalAlignment="Center"
                     IsEnabled="{Binding PlaybackEnabled}"
                     Text="{Binding PlaybackPort}" />
            <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding PlaybackEnabled}" />
          </StackPanel>
        </c:SettingRow>

      </StackPanel>
    </c:SmoothExpander>

    <!-- 推流鉴权 -->
    <c:SmoothExpander IsExpanded="{Binding IsAuthGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsAuthGroupShown}"
                      Title="{loc:Loc cs07-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls07-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <c:SettingRow Glyph="&#xE72E;"
                      Title="{loc:Loc cs07-002}"
                      Description="{loc:Loc ls07-002}">
          <ToggleSwitch IsChecked="{Binding AuthEnabled}" />
        </c:SettingRow>

      </StackPanel>
    </c:SmoothExpander>

    <!-- 拉流源（高级模式） -->
    <c:SmoothExpander IsExpanded="{Binding IsPullGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsPullGroupShown}"
                      Title="{loc:Loc cs08-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls08-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <c:SettingRow Glyph="&#xE896;"
                      Title="{loc:Loc cs08-002}"
                      Description="{loc:Loc ls08-002}">
          <ToggleSwitch IsChecked="{Binding PullOnDemand}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE916;"
                      Title="{loc:Loc cs08-003}"
                      Description="{loc:Loc ls08-003}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding PullStartTimeoutSeconds}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE916;"
                      Title="{loc:Loc cs08-004}"
                      Description="{loc:Loc ls08-004}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding PullCloseAfterSeconds}" />
        </c:SettingRow>

      </StackPanel>
    </c:SmoothExpander>

    <!-- 播放协议（高级模式） -->
    <c:SmoothExpander IsExpanded="{Binding IsPlaybackGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsPlaybackGroupShown}"
                      Title="{loc:Loc cs09-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls09-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <c:SettingRow Glyph="&#xE774;"
                      Title="{loc:Loc cs09-002}"
                      Description="{loc:Loc ls09-002}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBox Width="88" TextAlignment="Right" VerticalAlignment="Center"
                     IsEnabled="{Binding HlsEnabled}"
                     Text="{Binding HlsPort}" />
            <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding HlsEnabled}" />
          </StackPanel>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE774;"
                      Title="{loc:Loc cs09-003}"
                      Description="{loc:Loc ls09-003}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBox Width="88" TextAlignment="Right" VerticalAlignment="Center"
                     IsEnabled="{Binding WebrtcEnabled}"
                     Text="{Binding WebrtcPort}" />
            <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding WebrtcEnabled}" />
          </StackPanel>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE774;"
                      Title="{loc:Loc cs09-004}"
                      Description="{loc:Loc ls09-004}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBox Width="88" TextAlignment="Right" VerticalAlignment="Center"
                     IsEnabled="{Binding RtspEnabled}"
                     Text="{Binding RtspPort}" />
            <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding RtspEnabled}" />
          </StackPanel>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE774;"
                      Title="{loc:Loc cs09-005}"
                      Description="{loc:Loc ls09-005}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBox Width="88" TextAlignment="Right" VerticalAlignment="Center"
                     IsEnabled="{Binding SrtEnabled}"
                     Text="{Binding SrtPort}" />
            <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding SrtEnabled}" />
          </StackPanel>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE774;"
                      Title="{loc:Loc cs09-006}"
                      Description="{loc:Loc ls09-006}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBox Width="88" TextAlignment="Right" VerticalAlignment="Center"
                     IsEnabled="{Binding MoqEnabled}"
                     Text="{Binding MoqPort}" />
            <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding MoqEnabled}" />
          </StackPanel>
        </c:SettingRow>

      </StackPanel>
    </c:SmoothExpander>

    <!-- 连接治理（高级模式） -->
    <c:SmoothExpander IsExpanded="{Binding IsGovernanceGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsGovernanceGroupShown}"
                      Title="{loc:Loc cs10-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls10-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <c:SettingRow Glyph="&#xE968;"
                      Title="{loc:Loc cs10-002}"
                      Description="{loc:Loc ls10-002}">
          <TextBox Width="160" TextAlignment="Left" Text="{Binding RtspTransports}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE916;"
                      Title="{loc:Loc cs10-003}"
                      Description="{loc:Loc ls10-003}"
                      Warning="{loc:Loc ls00-003}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding WebrtcHandshakeTimeoutSeconds}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE916;"
                      Title="{loc:Loc cs10-004}"
                      Description="{loc:Loc ls10-004}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding WebrtcTrackGatherTimeoutSeconds}" />
        </c:SettingRow>

      </StackPanel>
    </c:SmoothExpander>

    <!-- 录制（高级模式） -->
    <c:SmoothExpander IsExpanded="{Binding IsRecordGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsRecordGroupShown}"
                      Title="{loc:Loc cs11-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls11-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <c:SettingRow Glyph="&#xE8B7;"
                      Title="{loc:Loc cs11-002}"
                      Description="{loc:Loc ls11-002}">
          <TextBox Width="330" TextAlignment="Left" Text="{Binding RecordPathTemplate}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE8A5;"
                      Title="{loc:Loc cs11-003}"
                      Description="{loc:Loc ls11-003}">
          <ComboBox HorizontalAlignment="Right" SelectedIndex="{Binding RecordFormatIndex, Mode=TwoWay}">
            <ComboBoxItem Content="fmp4" Tag="fmp4" />
            <ComboBoxItem Content="mpegts" Tag="mpegts" />
          </ComboBox>
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE916;"
                      Title="{loc:Loc cs11-004}"
                      Description="{loc:Loc ls11-004}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding RecordSegmentDuration}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE916;"
                      Title="{loc:Loc cs11-005}"
                      Description="{loc:Loc ls11-005}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding RecordMaxPartSize}" />
        </c:SettingRow>

        <c:SettingRow Glyph="&#xE74D;"
                      Title="{loc:Loc cs11-006}"
                      Description="{loc:Loc ls11-006}">
          <TextBox Width="88" TextAlignment="Right" Text="{Binding RecordDeleteAfter}" />
        </c:SettingRow>

      </StackPanel>
    </c:SmoothExpander>


    <!-- 目录 -->
    <c:SmoothExpander IsExpanded="{Binding IsCatalogGroupExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsCatalogGroupShown}"
                      Title="{loc:Loc cs12-001}">

      <StackPanel>

        <!-- 四行都是「图标 + 标题 + 路径 + 打开」：路径那一列用星号吃满中间，
             文字右对齐、超长从左侧裁——这样长的安装路径也能整条看见，不会被 360 掐断 -->

        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,10">
          <TextBlock Grid.Column="0"
                     Text="&#xE8B7;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="16"
                     Padding="2,0"
                     VerticalAlignment="Center"
                     Margin="0,0,14,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{loc:Loc cs12-002}"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding EngineDirText}"
                     Classes="hint"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Right"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding EngineDirText}" />
          <Button Grid.Column="3"
                  Margin="12,0,0,0"
                  Padding="10,2"
                  FontSize="11"
                  Content="{loc:Loc b001-003}"
                  Command="{Binding OpenFolderCommand}"
                  CommandParameter="engine" />
        </Grid>

        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,10">
          <TextBlock Grid.Column="0"
                     Text="&#xE713;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="16"
                     Padding="2,0"
                     VerticalAlignment="Center"
                     Margin="0,0,14,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{loc:Loc cs12-003}"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding ConfigDirText}"
                     Classes="hint"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Right"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ConfigDirText}" />
          <Button Grid.Column="3"
                  Margin="12,0,0,0"
                  Padding="10,2"
                  FontSize="11"
                  Content="{loc:Loc b001-003}"
                  Command="{Binding OpenFolderCommand}"
                  CommandParameter="config" />
        </Grid>

        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,10">
          <TextBlock Grid.Column="0"
                     Text="&#xE81C;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="16"
                     Padding="2,0"
                     VerticalAlignment="Center"
                     Margin="0,0,14,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{loc:Loc cs12-004}"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding LogsDirText}"
                     Classes="hint"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Right"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding LogsDirText}" />
          <Button Grid.Column="3"
                  Margin="12,0,0,0"
                  Padding="10,2"
                  FontSize="11"
                  Content="{loc:Loc b001-003}"
                  Command="{Binding OpenFolderCommand}"
                  CommandParameter="logs" />
        </Grid>

        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,10">
          <TextBlock Grid.Column="0"
                     Text="&#xE7C8;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="16"
                     Padding="2,0"
                     VerticalAlignment="Center"
                     Margin="0,0,14,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{loc:Loc cs13-004}"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding RecordDirText}"
                     Classes="hint"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Right"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding RecordDirText}" />
          <Button Grid.Column="3"
                  Margin="12,0,0,0"
                  Padding="10,2"
                  FontSize="11"
                  Content="{loc:Loc b001-003}"
                  Command="{Binding OpenFolderCommand}"
                  CommandParameter="record" />
        </Grid>

      </StackPanel>
    </c:SmoothExpander>

    <!-- 关于：版本号与作者自己写的那段话，和上面的目录分开成两组 -->
    <c:SmoothExpander IsExpanded="{Binding IsAboutPanelExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsAboutPanelShown}"
                      Title="{loc:Loc cs13-001}">

      <StackPanel>

        <TextBlock Text="{loc:Loc ls13-001}"
                   Classes="hint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Grid ColumnDefinitions="200,*">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Loc cs13-002}" Classes="field-label" />
            <Ellipse Width="6" Height="6" Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     Fill="{StaticResource DsSuccess}"
                     IsVisible="{Binding HasAppUpdate}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding VersionText}" Classes="hint" VerticalAlignment="Center" />
            <Button Padding="10,2"
                    FontSize="11"
                    VerticalAlignment="Center"
                    Content="{loc:Loc bs13-001}"
                    ToolTip.Tip="{Binding AppRepoText}"
                    Command="{Binding OpenProjectPageCommand}"
                    CommandParameter="app" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="200,*" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Loc cs13-003}" Classes="field-label" />
            <Ellipse Width="6" Height="6" Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     Fill="{StaticResource DsSuccess}"
                     IsVisible="{Binding HasEngineUpdate}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding EngineVersion}" Classes="hint" VerticalAlignment="Center" />
            <Button Padding="10,2"
                    FontSize="11"
                    VerticalAlignment="Center"
                    Content="{loc:Loc bs13-001}"
                    ToolTip.Tip="{Binding EngineRepoText}"
                    Command="{Binding OpenProjectPageCommand}"
                    CommandParameter="engine" />
          </StackPanel>
        </Grid>

        <!-- 推荐适配的引擎版本：跟软件版本号放一起看，用户才知道「适配到哪一版」 -->
        <Grid ColumnDefinitions="200,*" Margin="0,8,0,0">
          <TextBlock Text="{loc:Loc cs13-005}" Classes="field-label" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding RecommendedEngineVersionText}" Classes="hint" />
            <TextBlock Text="{loc:Loc ls13-003}"
                       Classes="hint"
                       Opacity="0.75"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <Border Height="1"
                Margin="0,14,0,12"
                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <TextBlock Text="{loc:Loc ls13-002}"
                   FontSize="12.5"
                   LineHeight="21"
                   TextWrapping="Wrap" />

      </StackPanel>
    </c:SmoothExpander>

  </StackPanel>
  </ScrollViewer>
</UserControl>
