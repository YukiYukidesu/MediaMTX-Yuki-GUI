<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:MediaMTX_Yuki_GUI"
             xmlns:c="using:MediaMTX_Yuki_GUI.Controls"
             x:Class="MediaMTX_Yuki_GUI.Views.OverviewPage">

  <!-- 关系图的节点：源与目标共用一套样子——就一颗胶囊，前面一个图标（启用是圆点、未启用是叉），
        后面是名字。底色与文字色由 ViewModel 给的状态开关决定，模板这里只负责认四个类名 -->
  <UserControl.Resources>
    <DataTemplate x:Key="MapNodeTemplate">
      <c:PillBadge Text="{Binding Title}"
                   Variant="{Binding Variant}"
                   ShowDot="True"
                   ToolTip.Tip="{Binding Tip}" />
    </DataTemplate>
  </UserControl.Resources>

  <!-- 三行：标题、运行状态、转发关系。底框占星号，关系图按自己的画布尺寸等比缩放 -->
  <Grid Margin="{StaticResource DsPagePadding}" RowDefinitions="Auto,Auto,*" RowSpacing="12">

    <!-- 标题区：右端放程序图标，右上角那个方块不再空着 -->
    <Grid Margin="{StaticResource DsCardGap}" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="{Binding PageTitle}" Classes="page-title" />
        <TextBlock Text="{Binding PageSubtitle}" Classes="page-subtitle" />
      </StackPanel>
      <!-- 图标要比标题块那一坨（约 42 DIP）大，否则右上角就吊着一个小方块、下面空一大截。
           但直接写 Width/Height 会把整行撑高、标题被顶着往下走，所以外面套一个定高的 Panel：
           行高由 Panel 的 44 决定，图标 64 在 Panel 里居中，上下各溢出一小截——
           溢出的那截正好把那块空填掉，右上角不再是一块孤零零的小色块 -->
      <Panel Grid.Column="1" Height="44" VerticalAlignment="Center">
        <Image Source="/Assets/app.ico"
               Width="64" Height="64" Margin="0,0,8,0"
               VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
      </Panel>
    </Grid>

    <!-- 运行状态 -->
    <Border Grid.Row="1" Classes="card status-card" Classes.running="{Binding IsEngineRunning}">
      <!-- 状态与按钮同处一行：左边说引擎怎么样，右边那颗按钮就是下一步动作 -->
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                   Classes="status-dot" Classes.on="{Binding IsEngineRunning}" />
          <TextBlock Text="{Binding EngineStatus}" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusDetail}" Classes="hint"
                     VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>

        <!-- 提示语贴着按钮那一侧，免得它孤零零挂在中间 -->
        <TextBlock Grid.Column="1" Text="{Binding IngestHint}" FontSize="11.5" Foreground="#E8A33D"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"
                   IsVisible="{Binding IngestHintVisible}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="primary" Content="{loc:Loc b002-001}"
                  Command="{Binding ToggleEngineCommand}"
                  IsVisible="{Binding IsEngineStopped}" />
          <Button Classes="danger-solid" Content="{loc:Loc b002-002}"
                  Command="{Binding ToggleEngineCommand}"
                  IsVisible="{Binding IsEngineRunning}" />
        </StackPanel>

      </Grid>
    </Border>

    <!-- 转发关系：标题与说明在框外，底框里只放关系图本身。
         底框占第 2 行（星号），一个节点都没有时它也照样占着那一块 -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0" Margin="{StaticResource DsCardGap}">
        <TextBlock Text="{loc:Loc c002-001}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Loc l002-003}" Classes="hint" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="1" Classes="well" Padding="12">
        <Grid x:Name="MapHost" RowDefinitions="*,Auto" SizeChanged="OnMapHostSizeChanged">

          <!-- 关系图：左列输入源、右列输出目标，中间用贝塞尔连线把绑定关系画出来。
               画布宽度跟着这块面板走（源列贴左、目标列贴右），节点少也铺满整块；
               节点多到一屏放不下就纵向滚动，不再整体缩小——缩到一半字就看不清了。
               横向不出滚动条：画布宽度按可用宽度算，窄到装不下时才靠最小宽度兜底 -->
      <Viewbox Grid.Row="0"
               Stretch="Uniform" StretchDirection="DownOnly"
               HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="{Binding MapWidth}" Height="{Binding MapHeight}">

              <!-- 每簇一圈淡边，方便看出装箱边界 -->
              <c:RelationBoxes Boxes="{Binding MapBoxes}"
                               Width="{Binding MapWidth}" Height="{Binding MapHeight}" />

              <!-- 连线垫在最底层，节点卡片盖在上面 -->
              <c:RelationLinks Links="{Binding MapLinks}"
                               Width="{Binding MapWidth}" Height="{Binding MapHeight}" />

              <ItemsControl ItemsSource="{Binding MapSources}"
                            Width="{Binding MapWidth}" Height="{Binding MapHeight}"
                            ItemTemplate="{StaticResource MapNodeTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <c:RelationCanvas LayoutVersion="{Binding MapVersion}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding MapTargets}"
                            Width="{Binding MapWidth}" Height="{Binding MapHeight}"
                            ItemTemplate="{StaticResource MapNodeTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <c:RelationCanvas LayoutVersion="{Binding MapVersion}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

            </Canvas>
      </Viewbox>

          <!-- 空状态浮在关系图那块的正中：底框照样占着那一块，只有这坨字挪到中间 -->
          <StackPanel Grid.Row="0" IsVisible="{Binding IsMapEmpty}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                      IsHitTestVisible="False">
            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{loc:Loc c002-002}" Classes="empty-title" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Loc l002-004}" Classes="hint" HorizontalAlignment="Center" />
          </StackPanel>

          <!-- 孤儿目标现在图上看得见，这条提示仍然有用：它在说这些目标不会被推流 -->
          <TextBlock Grid.Row="1" Text="{loc:Loc l002-005}" FontSize="11.5" Foreground="#D9822B"
                     Margin="0,8,0,0" TextWrapping="Wrap"
                     IsVisible="{Binding HasUnboundTargets}" />

        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>
