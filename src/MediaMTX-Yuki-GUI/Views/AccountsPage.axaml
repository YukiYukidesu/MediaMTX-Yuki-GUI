<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:MediaMTX_Yuki_GUI"
             xmlns:c="using:MediaMTX_Yuki_GUI.Controls"
             x:Class="MediaMTX_Yuki_GUI.Views.AccountsPage">
  <!-- 三行：标题、工具栏、底框。底框占星号，窗口怎么缩放它都自己长满 -->
  <Grid Margin="{StaticResource DsPagePadding}" RowDefinitions="Auto,Auto,*" RowSpacing="12">

    <StackPanel Margin="{StaticResource DsCardGap}">
      <TextBlock Text="{Binding PageTitle}" Classes="page-title" />
      <TextBlock Text="{Binding PageSubtitle}" Classes="page-subtitle" />
    </StackPanel>

    <!-- 工具栏：左侧全选与已选计数，中间一句统计，右侧批量删除与添加 -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Padding="10,4" FontSize="12"
                Content="{Binding SelectAllAccountsText}"
                ToolTip.Tip="{loc:Loc l001-001}"
                Command="{Binding ToggleSelectAllAccountsCommand}" />
        <TextBlock Text="{Binding AccountSelectionText}" Classes="hint" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Column="1"
                 Classes="hint"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Margin="12,0"
                 Text="{Binding AccountsSummary}" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                  HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Classes="danger-solid" Padding="10,4" FontSize="12"
                Content="{loc:Loc b001-004}" Command="{Binding RemoveSelectedAccountsCommand}" />
        <Button Classes="primary" Padding="12,4" FontSize="12"
                Content="{loc:Loc l005-003}" Command="{Binding AddAccountCommand}" />
      </StackPanel>
    </Grid>

    <!-- 表格垫在一块极浅的底窗上，跟两个列表页同一套观感 -->
    <Border Grid.Row="2" Classes="well" Padding="8,8,8,8">
      <Grid RowDefinitions="Auto,*">

        <!-- 一个账号都没有时列头一起收起来，空状态浮在框内正中 -->
        <Grid Grid.Row="0"
              ColumnDefinitions="28,*,*,*,140"
              ColumnSpacing="8"
              Margin="16,0,16,6"
              IsVisible="{Binding HasAccounts}">
          <TextBlock Grid.Column="1" Classes="column-header" Text="{loc:Loc c005-001}" HorizontalAlignment="Left" />
          <TextBlock Grid.Column="2" Classes="column-header" Text="{loc:Loc c005-002}" HorizontalAlignment="Left" />
          <TextBlock Grid.Column="3" Classes="column-header" Text="{loc:Loc c005-003}" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="4" Classes="column-header" Text="{loc:Loc c001-011}" HorizontalAlignment="Left" Margin="8,0,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Accounts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Padding="16,10" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="28,*,*,*,140" ColumnSpacing="8">

                    <!-- 行首勾选框只喂批量删除；Fluent 模板自带左边 8 的内边距，要抹掉 -->
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected}"
                              VerticalAlignment="Center"
                              Padding="0"
                              MinWidth="0" />

                    <!-- 用户名与密码占位是短值，各占一色；密码不给原文，只给长度 -->
                    <c:PillBadge Grid.Column="1"
                                 Variant="Id"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding User}"
                                 ToolTip.Tip="{Binding User}" />

                    <c:PillBadge Grid.Column="2"
                                 Variant="Metric"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding PasswordMask}" />

                    <!-- 能否观看是两态，能看取绿、不能看取红，跟别的列表的开关同一套语义 -->
                    <c:PillBadge Grid.Column="3"
                                 Variant="{Binding CanViewVariant}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Text="{Binding CanViewText}" />

                    <!-- 右段固定：只有编辑与删除两颗，靠左摆，与表头对齐 -->
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="2"
                                HorizontalAlignment="Left"
                                Margin="8,0,0,0">
                      <Button Classes="icon-square"
                              ToolTip.Tip="{loc:Loc l001-002}"
                              Command="{Binding $parent[Window].DataContext.EditAccountCommand}"
                              CommandParameter="{Binding}">
                        <TextBlock Classes="glyph" Text="&#xE70F;" />
                      </Button>
                      <Button Classes="icon-square danger"
                              ToolTip.Tip="{loc:Loc l001-003}"
                              Click="OnRemoveAccountClick">
                        <TextBlock Classes="glyph" Text="&#xE74D;" />
                      </Button>
                    </StackPanel>

                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsAccountsEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6"
                    IsHitTestVisible="False">
          <TextBlock Text="&#xE716;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="34"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Classes="empty-title" Text="{loc:Loc c005-004}" />
          <TextBlock Classes="hint" Text="{loc:Loc l005-004}" />
        </StackPanel>

      </Grid>
    </Border>
  </Grid>
</UserControl>
