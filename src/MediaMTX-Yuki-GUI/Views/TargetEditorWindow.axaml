<ui:FAAppWindow x:Class="MediaMTX_Yuki_GUI.Views.TargetEditorWindow"
                xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:FluentAvalonia.UI.Windowing"
                xmlns:loc="using:MediaMTX_Yuki_GUI"
                Title="{Binding WindowTitle}"
                Width="560"
                MinHeight="560"
                MaxHeight="1000"
                SizeToContent="Height"
                CanResize="False"
                CanMaximize="False"
                WindowStartupLocation="CenterOwner"
                TextOptions.TextRenderingMode="Antialias">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">

    <TextBlock Grid.Row="0"
               Margin="0,0,0,20"
               Classes="page-subtitle"
               Text="{loc:Loc l009-001}" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <TextBlock Classes="field-label" Text="{loc:Loc c009-003}" />
        <TextBox Margin="0,4,0,4" Text="{Binding TargetName, Mode=TwoWay}" />

        <!-- 重名只提醒不拦：两条备注一样也能存，只是提醒别搞混 -->
        <TextBlock Margin="0,0,0,12"
                   Classes="warning-hint"
                   IsVisible="{Binding HasNameWarning}"
                   Text="{Binding NameWarning}" />

        <TextBlock Classes="field-label" Text="{loc:Loc c009-004}" />
        <ComboBox Margin="0,4,0,16"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding PlatformChoices}"
                  SelectedItem="{Binding SelectedPlatformChoice, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="field-label" Text="{loc:Loc c009-013}" />
          <TextBlock Text="*" Classes="required-mark" />
        </StackPanel>
        <TextBox Margin="0,4,0,4"
                 Classes.invalid="{Binding ServerInvalid}"
                 LostFocus="OnServerLostFocus"
                 Text="{Binding Server, Mode=TwoWay}" />
        <TextBlock Margin="0,0,0,4"
                   Classes="danger-hint"
                   IsVisible="{Binding ServerInvalid}"
                   Text="{loc:Loc c009-022}" />
        <TextBlock Classes="hint" Text="{loc:Loc l009-008}" />

        <TextBlock Margin="0,16,0,0" Classes="field-label" Text="{loc:Loc c009-014}" />
        <TextBox Margin="0,4,0,4" Text="{Binding StreamKey, Mode=TwoWay}" />
        <TextBlock Classes="hint" Text="{loc:Loc l009-009}" />

        <TextBlock Margin="0,16,0,0" Classes="field-label" Text="{loc:Loc c009-015}" />
        <ComboBox Margin="0,4,0,0"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding InputChoices}"
                  SelectedItem="{Binding SelectedInputChoice, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Margin="0,4,0,0"
                   Classes="danger-hint"
                   IsVisible="{Binding HasNoInput}"
                   Text="{loc:Loc l009-010}" />

        <TextBlock Margin="0,16,0,0" Classes="field-label" Text="{loc:Loc c009-028}" />
        <ComboBox Margin="0,4,0,0"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="{Binding ProxyIndex, Mode=TwoWay}"
                  IsEnabled="{Binding CanUseProxy}">
          <ComboBoxItem Content="{loc:Loc c009-017}" Tag="follow" />
          <ComboBoxItem Content="{loc:Loc c009-018}" Tag="direct" />
          <ComboBoxItem Content="{loc:Loc c009-019}" Tag="system" />
          <ComboBoxItem Content="{loc:Loc c009-020}" Tag="custom" />
        </ComboBox>
        <TextBlock Classes="hint" Text="{loc:Loc l009-014}" />
        <TextBlock Margin="0,4,0,0"
                   Classes="danger-hint"
                   IsVisible="{Binding !CanUseProxy}"
                   Text="{loc:Loc l009-012}" />

        <StackPanel IsVisible="{Binding HasCustomProxy}">
          <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="field-label" Text="{loc:Loc c009-021}" />
            <TextBlock Text="*" Classes="required-mark" />
          </StackPanel>
          <TextBox Margin="0,4,0,4"
                   Classes.invalid="{Binding ProxyUrlInvalid}"
                   LostFocus="OnProxyUrlLostFocus"
                   Text="{Binding ProxyUrl, Mode=TwoWay}"
                   PlaceholderText="socks5://127.0.0.1:8888" />
          <TextBlock Margin="0,0,0,4"
                     Classes="danger-hint"
                     IsVisible="{Binding ProxyUrlInvalid}"
                     Text="{loc:Loc l009-013}" />
          <TextBlock Classes="hint" Text="{loc:Loc l009-011}" />
        </StackPanel>

        <StackPanel Margin="0,16,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
          <TextBlock VerticalAlignment="Center" Text="{loc:Loc c009-024}" />
          <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- 缺什么直接标在对应的框下面了，这里只管放按钮 -->
    <StackPanel Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button MinWidth="88"
              Content="{loc:Loc c009-025}"
              Command="{Binding CancelCommand}"
              IsCancel="True" />
      <Button Margin="8,0,0,0" MinWidth="88" Classes="primary" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" />
    </StackPanel>
  </Grid>
</ui:FAAppWindow>
