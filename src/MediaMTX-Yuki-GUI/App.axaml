<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.Styling"
             x:Class="MediaMTX_Yuki_GUI.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />
    <fa:FluentAvaloniaTheme CustomAccentColor="#0078D4" />
    <StyleInclude Source="avares://MediaMTX-Yuki-GUI/Resources/DesignSystem.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MediaMTX-Yuki-GUI/Resources/PillPalette.axaml" />
        <ResourceInclude Source="avares://MediaMTX-Yuki-GUI/Resources/ToastPalette.axaml" />
        <ResourceInclude Source="avares://MediaMTX-Yuki-GUI/Resources/SurfacePalette.axaml" />
        <ResourceInclude Source="avares://MediaMTX-Yuki-GUI/Resources/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
