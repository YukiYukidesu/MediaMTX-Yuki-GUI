<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    胶囊标签的配色。每个变体一对笔刷：底色是语义色的浅色版，文字是同色系的实色。

    变体分四组：状态（Plain / On / Off / Warn / Error）、枚举值（协议四色、来源 Pull / Push、
    代理 Follow / Direct / Custom）、平台品牌色（Bilibili / Douyin / Kuaishou / Youtube / Twitch /
    Huya / Douyu，一个平台一个色，色相照着各家的标识）、字段值（Id 给编号、用户名、平台名这类短标识，
    Metric 给速率、占用、延迟、时间这些数字）。长字符串（地址、备注名）仍走 Plain —— 一条长条挂满颜色只会更乱。

    代理三档的语义色：系统 / 跟随走绿（Follow）、手动 / 自定义走黄（Custom）、直连保持中性灰蓝（Direct）——
    「不走代理」本身不是一个决定，不该跟「走哪条代理」抢颜色。

    平台色只给 7 个内置平台：自定义平台（PresetCatalog 的 custom）没有品牌色可依，走 Plain。

    取值不是拍脑袋定的：浅色按「卡片底色 #FFFFFF、底色再掺 14%」、深色按「卡片底色 #2B2B2B、掺 18%」
    反算，全部达到 WCAG AA 的 4.5:1（23 个变体实测：浅色 4.74 ~ 14.36、深色 5.20 ~ 12.17）。
    算过的表与依据见 docs\UI参考-设计规范.md §二。

    Off（已停用）用暗红而不是灰：停用是「这条现在不干活」，在列表里属于要一眼看出的状态；
    与 Error 的亮红 #B3261E 拉开层次（暗红更沉、更偏砖色），两颗粒子并排也不会看混。

    变体名与 Controls\PillBadge.cs 的 PillVariant 一一对应，键名拼接规则是 Pill{变体}Foreground / Pill{变体}Background，
    改名字要两边一起改。
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="PillPlainForeground" Color="#4A4A4A" />
      <SolidColorBrush x:Key="PillPlainBackground" Color="#F1F1F1" />
      <SolidColorBrush x:Key="PillOnForeground" Color="#1E7B4F" />
      <SolidColorBrush x:Key="PillOnBackground" Color="#E4FAEE" />
      <SolidColorBrush x:Key="PillOffForeground" Color="#8C3A36" />
      <SolidColorBrush x:Key="PillOffBackground" Color="#F7E4E1" />
      <SolidColorBrush x:Key="PillWarnForeground" Color="#8A5A00" />
      <SolidColorBrush x:Key="PillWarnBackground" Color="#FDF2E0" />
      <SolidColorBrush x:Key="PillErrorForeground" Color="#B3261E" />
      <SolidColorBrush x:Key="PillErrorBackground" Color="#FFEAEA" />
      <SolidColorBrush x:Key="PillRtmpForeground" Color="#1B5FA8" />
      <SolidColorBrush x:Key="PillRtmpBackground" Color="#E6F1FC" />
      <SolidColorBrush x:Key="PillRtmpsForeground" Color="#3A3FA8" />
      <SolidColorBrush x:Key="PillRtmpsBackground" Color="#EDEEFC" />
      <SolidColorBrush x:Key="PillRtspForeground" Color="#0B6A6E" />
      <SolidColorBrush x:Key="PillRtspBackground" Color="#E4F7F8" />
      <SolidColorBrush x:Key="PillSrtForeground" Color="#6A2FA0" />
      <SolidColorBrush x:Key="PillSrtBackground" Color="#F5EDFC" />
      <SolidColorBrush x:Key="PillPullForeground" Color="#14664F" />
      <SolidColorBrush x:Key="PillPullBackground" Color="#E4F3EC" />
      <SolidColorBrush x:Key="PillPushForeground" Color="#2F5A8F" />
      <SolidColorBrush x:Key="PillPushBackground" Color="#E9F0F8" />
      <SolidColorBrush x:Key="PillFollowForeground" Color="#0F7A4A" />
      <SolidColorBrush x:Key="PillFollowBackground" Color="#E4F6EC" />
      <SolidColorBrush x:Key="PillDirectForeground" Color="#3F5A73" />
      <SolidColorBrush x:Key="PillDirectBackground" Color="#E9EFF4" />
      <SolidColorBrush x:Key="PillCustomForeground" Color="#8A6200" />
      <SolidColorBrush x:Key="PillCustomBackground" Color="#FBF3DC" />
      <SolidColorBrush x:Key="PillBilibiliForeground" Color="#C2185B" />
      <SolidColorBrush x:Key="PillBilibiliBackground" Color="#FCE4EC" />
      <SolidColorBrush x:Key="PillDouyinForeground" Color="#17181B" />
      <SolidColorBrush x:Key="PillDouyinBackground" Color="#E6E7EA" />
      <SolidColorBrush x:Key="PillKuaishouForeground" Color="#B03A0A" />
      <SolidColorBrush x:Key="PillKuaishouBackground" Color="#FBEAE2" />
      <SolidColorBrush x:Key="PillYoutubeForeground" Color="#C62828" />
      <SolidColorBrush x:Key="PillYoutubeBackground" Color="#FBE9E7" />
      <SolidColorBrush x:Key="PillTwitchForeground" Color="#6A3FC0" />
      <SolidColorBrush x:Key="PillTwitchBackground" Color="#EFE9FC" />
      <SolidColorBrush x:Key="PillHuyaForeground" Color="#955800" />
      <SolidColorBrush x:Key="PillHuyaBackground" Color="#FCEEDC" />
      <SolidColorBrush x:Key="PillDouyuForeground" Color="#B04A00" />
      <SolidColorBrush x:Key="PillDouyuBackground" Color="#FDEBDF" />
      <SolidColorBrush x:Key="PillIdForeground" Color="#46607E" />
      <SolidColorBrush x:Key="PillIdBackground" Color="#EAF0F7" />
      <SolidColorBrush x:Key="PillMetricForeground" Color="#6A5335" />
      <SolidColorBrush x:Key="PillMetricBackground" Color="#F4EEE3" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="PillPlainForeground" Color="#C8C8C8" />
      <SolidColorBrush x:Key="PillPlainBackground" Color="#3F3F3F" />
      <SolidColorBrush x:Key="PillOnForeground" Color="#7BE3A9" />
      <SolidColorBrush x:Key="PillOnBackground" Color="#2E4B3B" />
      <SolidColorBrush x:Key="PillOffForeground" Color="#E8A9A2" />
      <SolidColorBrush x:Key="PillOffBackground" Color="#4A3230" />
      <SolidColorBrush x:Key="PillWarnForeground" Color="#F5C46B" />
      <SolidColorBrush x:Key="PillWarnBackground" Color="#4E4029" />
      <SolidColorBrush x:Key="PillErrorForeground" Color="#FF9E9E" />
      <SolidColorBrush x:Key="PillErrorBackground" Color="#513737" />
      <SolidColorBrush x:Key="PillRtmpForeground" Color="#8FC4F5" />
      <SolidColorBrush x:Key="PillRtmpBackground" Color="#31404D" />
      <SolidColorBrush x:Key="PillRtmpsForeground" Color="#B7BCF7" />
      <SolidColorBrush x:Key="PillRtmpsBackground" Color="#393B4E" />
      <SolidColorBrush x:Key="PillRtspForeground" Color="#86DDDF" />
      <SolidColorBrush x:Key="PillRtspBackground" Color="#2E4748" />
      <SolidColorBrush x:Key="PillSrtForeground" Color="#CFA6F5" />
      <SolidColorBrush x:Key="PillSrtBackground" Color="#44394D" />
      <SolidColorBrush x:Key="PillPullForeground" Color="#86E0C6" />
      <SolidColorBrush x:Key="PillPullBackground" Color="#23453A" />
      <SolidColorBrush x:Key="PillPushForeground" Color="#A6C4EA" />
      <SolidColorBrush x:Key="PillPushBackground" Color="#303E4E" />
      <SolidColorBrush x:Key="PillFollowForeground" Color="#62D9A2" />
      <SolidColorBrush x:Key="PillFollowBackground" Color="#2C4639" />
      <SolidColorBrush x:Key="PillDirectForeground" Color="#A9C3D1" />
      <SolidColorBrush x:Key="PillDirectBackground" Color="#33424B" />
      <SolidColorBrush x:Key="PillCustomForeground" Color="#F2C65F" />
      <SolidColorBrush x:Key="PillCustomBackground" Color="#4A4029" />
      <SolidColorBrush x:Key="PillBilibiliForeground" Color="#FFA6C4" />
      <SolidColorBrush x:Key="PillBilibiliBackground" Color="#4A2F3B" />
      <SolidColorBrush x:Key="PillDouyinForeground" Color="#E8E9ED" />
      <SolidColorBrush x:Key="PillDouyinBackground" Color="#26282C" />
      <SolidColorBrush x:Key="PillKuaishouForeground" Color="#FFA27A" />
      <SolidColorBrush x:Key="PillKuaishouBackground" Color="#4A3328" />
      <SolidColorBrush x:Key="PillYoutubeForeground" Color="#FF8A80" />
      <SolidColorBrush x:Key="PillYoutubeBackground" Color="#4E2F2D" />
      <SolidColorBrush x:Key="PillTwitchForeground" Color="#C2A8FF" />
      <SolidColorBrush x:Key="PillTwitchBackground" Color="#3A3350" />
      <SolidColorBrush x:Key="PillHuyaForeground" Color="#FFC65E" />
      <SolidColorBrush x:Key="PillHuyaBackground" Color="#493B27" />
      <SolidColorBrush x:Key="PillDouyuForeground" Color="#FFAE73" />
      <SolidColorBrush x:Key="PillDouyuBackground" Color="#4A3527" />
      <SolidColorBrush x:Key="PillIdForeground" Color="#A9C0DC" />
      <SolidColorBrush x:Key="PillIdBackground" Color="#34404F" />
      <SolidColorBrush x:Key="PillMetricForeground" Color="#D8BE96" />
      <SolidColorBrush x:Key="PillMetricBackground" Color="#453B2E" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
